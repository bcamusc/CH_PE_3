# Copia este archivo a ".env" y completa tu clave:
#   Copy-Item .env.example .env   (Windows PowerShell)
#   cp .env.example .env          (macOS / Linux)
#
# Consigue una clave gratuita en: https://aistudio.google.com/apikey
#
# ⚠️ El archivo .env está en .gitignore: NUNCA se sube al repositorio.
# ⚠️ OJO: este archivo (.env.example) SÍ se sube al repo → jamás poner claves reales aquí.
GOOGLE_API_KEY=tu_clave_aca
